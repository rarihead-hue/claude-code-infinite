# --- Microsoft 365 / Graph (Azure AD app registration, application permission Mail.ReadWrite) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# The MAILBOX that receives the distribution list mail (a DL itself cannot be read; see README)
MAILBOX=customs-automation@rxo.com
SOURCE_FOLDER=Inbox
DONE_FOLDER=Qargo - Uploaded
REVIEW_FOLDER=Qargo - Needs Review

# --- Qargo ---
QARGO_BASE_URL=https://api.qargo.com
QARGO_CLIENT_ID=
QARGO_CLIENT_SECRET=
QARGO_DOCUMENT_TYPE=Customs Document

# --- Behaviour ---
DRY_RUN=true
POLL_SECONDS=60
STATE_DB=state.sqlite3
